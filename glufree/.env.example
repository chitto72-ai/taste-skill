# Chiave API Google (Places API New). Senza chiave l'app usa il dataset demo incluso.
# Abilita "Places API (New)" su https://console.cloud.google.com/apis/library
GOOGLE_MAPS_API_KEY=

# Facoltativo: chiave admin per approvare le richieste di verifica dei ristoratori
GLUFREE_ADMIN_KEY=cambiami

# --- Monetizzazione con Google AdSense (facoltativa) ---
# Lascia vuoto per disattivare del tutto la pubblicità (nessuno script caricato).
# ID publisher AdSense, es. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# ID delle unità annuncio create nella dashboard AdSense
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_LIST=
