# =============================================================================
# Memecoin Trading Bot - environment template
# Copy to `.env` and fill in. Every value here is optional unless marked
# REQUIRED; anything omitted falls back to config/default.config.ts.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# live | paper | backtest   -> `paper` never signs a real transaction.
BOT_MODE=paper
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# --- Execution venue (Axiom Pro compatible) ----------------------------------
# Axiom does not publish a stable public API contract; endpoints and auth are
# configuration, not code. Leave empty to run entirely on the paper venue.
AXIOM_ENABLED=false
AXIOM_REST_URL=https://api.axiom.trade
AXIOM_WS_URL=wss://api.axiom.trade/ws
AXIOM_API_KEY=
AXIOM_API_SECRET=
# Milliseconds
AXIOM_TIMEOUT_MS=10000
AXIOM_MAX_RPS=8

# --- Wallets -----------------------------------------------------------------
# Encrypted keystore directory + passphrase. Private keys are NEVER read from
# env in live mode; use `memecoin-bot wallet:import` to seal them.
KEYSTORE_DIR=./keystore
KEYSTORE_PASSPHRASE=

# --- RPC endpoints (comma separated, first = primary, rest = failover) --------
RPC_SOLANA=https://api.mainnet-beta.solana.com
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_BASE=https://mainnet.base.org
RPC_BSC=https://bsc-dataseed.binance.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_HYPERLIQUID=https://rpc.hyperliquid.xyz/evm

# Chains the bot is allowed to trade (comma separated ids from chains.config.ts)
ENABLED_CHAINS=solana,base,bsc,ethereum

# --- Capital & risk ----------------------------------------------------------
# Quote-currency units (USD equivalent).
CAPITAL_BASE=10000
RISK_PER_TRADE_PCT=0.5
MAX_CONCURRENT_POSITIONS=5
MAX_DAILY_DRAWDOWN_PCT=5
MAX_CONSECUTIVE_STOPS=3
KELLY_FRACTION=0.25

# --- Discovery / scoring -----------------------------------------------------
MIN_TOKEN_SCORE=80
SCANNER_INTERVAL_MS=3000
MIN_LIQUIDITY_USD=25000
MAX_TOKEN_AGE_MINUTES=1440

# --- Copy trading (optional module) -----------------------------------------
COPY_TRADING_ENABLED=false
COPY_MIN_WIN_RATE=0.7
COPY_MIN_TRADES=300
COPY_MIN_WALLET_AGE_DAYS=90

# --- Persistence -------------------------------------------------------------
# memory | file | sqlite
DB_DRIVER=file
DB_PATH=./data/bot.db

# --- Dashboard / API ---------------------------------------------------------
API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=8080
# Required when API_ENABLED=true and the host is not loopback.
API_TOKEN=
