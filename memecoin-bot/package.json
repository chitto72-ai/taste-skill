{
  "name": "@quant/memecoin-bot",
  "version": "1.0.0",
  "description": "Production-grade multi-chain memecoin trading bot (Axiom Pro compatible venues)",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "bin": {
    "memecoin-bot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js run",
    "dev": "tsx watch src/cli.ts run",
    "backtest": "tsx src/cli.ts backtest",
    "scan": "tsx src/cli.ts scan",
    "doctor": "tsx src/cli.ts doctor",
    "docs": "tsx scripts/generate-docs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts tests --max-warnings 0",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\"",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:stress": "vitest run --project stress",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@solana/web3.js": "^1.95.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "viem": "^2.21.19",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  },
  "license": "MIT",
  "private": true
}
